{
  "name": "dsh-windows-notify",
  "description": "Windows-grade notifications for DeepSeek Harness: system toasts, custom sounds, and a taskbar tray badge for task completion and decision prompts — a native DSH profile plugin (bundle + client + settings namespace), zero patching of built-in packages.",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "scripts"
  ],
  "scripts": {
    "test": "node test.mjs",
    "pack": "node pack.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notifications",
    "windows",
    "toast",
    "tray"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-windows-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-windows-notify/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-windows-notify#readme"
}
